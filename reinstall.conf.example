#!/usr/bin/env bash
# reinstall.conf — copy to reinstall.conf and edit. All values optional;
# blank network/disk fields are auto-detected. Auto-loaded from ./reinstall.conf
# or /etc/reinstall.conf, or via --config FILE. Unknown keys are ignored.
# Precedence: interactive prompt > environment > config file > detection > defaults.
# This tool uses Bash arrays and is not POSIX sh.
DEBIAN_SUITE="trixie"
MIRROR="https://deb.debian.org/debian"
TIMEZONE="Asia/Kolkata"
TARGET_DISK=""      # Auto-detected if blank (e.g. /dev/vda, /dev/sda, /dev/nvme0n1)
PRIMARY_IFACE=""    # Auto-detected if blank (e.g. eth0)
IPV4_ADDR=""        # Auto-detected if blank
NETMASK=""          # Auto-detected if blank
GATEWAY=""          # Auto-detected if blank
DNS_SERVERS="1.1.1.1 1.0.0.1"
IPV6_ADDR=""        # Auto-detected if blank
IPV6_PREFIX=""      # Auto-detected if blank
IPV6_GATEWAY=""     # Auto-detected if blank
HOSTNAME="debian"
DOMAIN="local"
BOOT_MODE=""        # Auto-detected if blank (uefi or bios)
NIC_MODULE=""       # Auto-detected if blank (kernel module for ethernet card, e.g. virtio_net)
ADMIN_USER="admin"  # Hardened SSH username created post-install
ADMIN_SSH_PUBKEY="" # Paste your SSH public key string here (e.g. "ssh-ed25519 AAAA...")
ADMIN_SSH_PUBKEY_FILE="" # Or path to pubkey file (auto-detects /root/.ssh/authorized_keys if blank)
ADMIN_PASSWORD_HASH="" # Optional hashed password (if blank, password login is disabled & SSH key-only)
SSH_PORT="2222"     # Hardened OpenSSH server port (post-install login)
DROPBEAR_PORT="22"  # Dropbear SSH port (used to unlock LUKS during boot)
WEB_PORTS="80 443"  # Ports allowed through UFW firewall
BOOT_SIZE_MB="1024" # Size of unencrypted /boot partition in MB
SWAP_SIZE_MB="4096" # Size of encrypted swap partition in MB
LUKS_PASSPHRASE=""  # LUKS encryption passphrase (min 8 chars; prompted interactively if blank)
ASSUME_YES="no"     # Set to "yes" to bypass interactive confirmation prompts
WORKDIR=""          # Temp work directory (auto-created in RAM/tmp if blank)
LOG_FILE=""         # Log file path (auto-generated in /tmp if blank)
LOG_LEVEL="INFO"
